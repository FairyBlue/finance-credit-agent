  "source_code_evidence": [
    {
      "path": "/home/tianming/projects/finance-credit-agent/runs/m2-parameter-grid-20261008-r5/sources/src/agents/screening_runtime.py",
      "excerpts": [
        {
          "first_line": 201,
          "last_line": 222,
          "text": "def _scope_diagnostics(unwhitened: Any, residual: Any) -> dict[str, object]:\n    import torch\n\n    # Diagnostic arithmetic uses float64 but does not enter optimizer tensors.\n    u = unwhitened.detach().double()\n    s = residual.detach().double()\n    u_std = u.std(correction=1)\n    s_std = s.std(correction=1)\n    correlation = None\n    if u_std > 0 and s_std > 0:\n        correlation = float(\n            (((u - u.mean()) * (s - s.mean())).sum() / ((u.numel() - 1) * u_std * s_std)).item()\n        )\n    return {\n        \"row_count\": u.numel(),\n        \"std_U\": float(u_std.item()),\n        \"std_S\": float(s_std.item()),\n        \"corr_U_S\": correlation,\n        \"mean_abs_S\": float(s.abs().mean().item()),\n        \"nonzero_S_count\": int(torch.count_nonzero(s.abs() > DIAGNOSTIC_ATOL).item()),\n        \"nonzero_S_rate\": float((s.abs() > DIAGNOSTIC_ATOL).double().mean().item()),\n        \"exact_nonzero_S_count\": int(torch.count_nonzero(s).item()),"
        },
        {
          "first_line": 317,
          "last_line": 324,
          "text": "        raw_residual = credits.pooled if arm == \"M2\" else credits.plain\n        residual = torch.tensor(raw_residual, dtype=u.dtype, device=u.device)\n        if arm in {\"A2\", \"M1\"}:\n            residual.zero_()\n        residual = residual * eta\n        combined = u + residual\n        std = combined.std(correction=1)\n        scalar_advantages = (combined - combined.mean()) / (std + 1e-8)"
        },
        {
          "first_line": 342,
          "last_line": 344,
          "text": "            \"all_real_steps\": _scope_diagnostics(u, residual),\n            \"advancing_steps\": _scope_diagnostics(u[advancing_mask], residual[advancing_mask]),\n            \"whitening_std\": float(std.item()),"
        },
        {
          "first_line": 368,
          "last_line": 374,
          "text": "                    \"financial_step_reward\": float(financial_step_rewards[position].item()),\n                    \"invalid_penalty\": invalid_action_penalty * row.invalid_action,\n                    \"training_step_reward\": float(training_step_rewards[position].item()),\n                    \"unwhitened_U\": float(u[position].item()),\n                    \"sibling_residual\": float(residual[position].item()),\n                    \"final_actor_advantage\": float(scalar_advantages[position].item()),\n                    \"critic_return\": float(step_returns[position].item()),"
        }
      ]
    },
    {
      "path": "/home/tianming/projects/finance-credit-agent/runs/m2-parameter-grid-20261008-r5/sources/src/agents/parameter_grid_readout.py",
      "excerpts": [
        {
          "first_line": 535,
          "last_line": 541,
          "text": "                for name in (\"mean_abs_S\", \"std_S\", \"std_U\", \"corr_U_S\", \"nonzero_S_rate\"):\n                    item[\"residual_\" + name] = row[\"all_real_steps\"].get(name)\n                std_u = row[\"all_real_steps\"].get(\"std_U\")\n                std_s = row[\"all_real_steps\"].get(\"std_S\")\n                item[\"residual_scaled_std_ratio\"] = (\n                    eta * std_s / std_u if std_u and std_s is not None else None\n                )"
        }
      ]
    },
    {
      "path": "/home/tianming/projects/finance-credit-agent/runs/m2-parameter-grid-20261008-r5/sources/src/rewards/sibling_credit.py",
      "excerpts": [
        {
          "first_line": 169,
          "last_line": 179,
          "text": "            histogram[rows[index].action] += 1\n        if len(cells) == 1:\n            continue\n        diverse_count += 1\n        pooling_opportunities += int(max(map(len, cells.values())) >= 2)\n        group_mean = math.fsum(rows[i].terminal_score for i in indices) / ROLLOUT_N\n        for cell in cells.values():\n            cell_mean = math.fsum(rows[i].terminal_score for i in cell) / len(cell)\n            for index in cell:\n                plain[index] = rows[index].terminal_score - group_mean\n                pooled[index] = cell_mean - group_mean"
        },
        {
          "first_line": 183,
          "last_line": 209,
          "text": "    session_count = len(session_groups)\n    advancing_count = sum(advancing)\n    changed_count = sum(\n        abs(pooled[i] - plain[i]) > DIAGNOSTIC_ATOL + DIAGNOSTIC_RTOL * abs(plain[i])\n        for i in range(len(rows))\n        if advancing[i]\n    )\n    return SiblingCredit(\n        plain=tuple(plain),\n        pooled=tuple(pooled),\n        advancing=tuple(advancing),\n        diagnostics={\n            \"policy_step\": next(iter(policy_steps)),\n            \"episode_group_count\": len(groups),\n            \"trajectory_count\": len(trajectories),\n            \"real_step_count\": len(rows),\n            \"advancing_row_count\": advancing_count,\n            \"session_group_count\": session_count,\n            \"action_diversity_rate\": diverse_count / session_count,\n            \"pooling_opportunity_rate\": pooling_opportunities / session_count,\n            \"pooling_changed_row_count\": changed_count,\n            \"pooling_changed_row_rate\": changed_count / advancing_count,\n            \"action_family_histogram\": {\n                action: histogram[action] for action in sorted(ACTION_FAMILIES)\n            },\n            \"invalid_step_count\": sum(row.invalid_action for row in rows),\n            \"diagnostic_atol\": DIAGNOSTIC_ATOL,"
        }
      ]
    }
  ],
  "field_semantics": {
    "U": "Recorded unwhitened StepPO-GAE scalar, including the common invalid-action penalty.",
    "R": "reward_evidence.sibling_residual is the already scaled actor residual eta*S; eta=0.25.",
    "std_S": "Existing all_real_steps.std_S is the sample std (correction=1) of R, despite its name S. std_U uses the same rows and correction.",
    "corrected_ratio": "std(R)/std(U), taken directly from existing std_S/std_U. Existing CSV multiplies eta a second time and reports eta*std(R)/std(U).",
    "nonzero": "Existing absolute tolerance diagnostic_atol (recorded in each source) applied to already scaled R; exact and tolerance-based counts agree in all eight batches.",
    "gate": "action_diversity_rate: fraction of 40 four-sibling decision-session groups per update containing more than one action family.",
    "pooling_change": "Fraction of advancing rows whose pooled raw credit differs from same-gate plain raw credit by atol+rtol*abs(plain), from recorded diagnostics.",
    "actor_contribution": "Centered R divided by the recorded std(U+R)+epsilon, measured before the actor update.",
    "arithmetic_actor_delta": "Saved final actor advantage minus Whiten(U) in the same recorded batch. This is a numerical removal of the residual holding U and sampled rows fixed, not a trained M1 counterfactual or a causal performance effect.",
    "aggregation": "Coverage counts pooled across recorded rows/session groups. Scale ratios are separately summarized across updates; not stds of pooled seed/episode mixtures."
  },
